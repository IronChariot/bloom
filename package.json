  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.2.0",
    "playwright": "1.58.2"
  }
}
