{
  "name": "bloom-brainstorm",
  "version": "0.1.0",
  "description": "An elastic brainstorm canvas for humans and agents",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui.mjs",
